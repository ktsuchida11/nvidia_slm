{
  "rest": {
    "RestGenerator": {
      "name": "raw-vllm-endpoint",
      "uri": "http://host.docker.internal:8002/v1/chat/completions",
      "method": "post",
      "headers": { "Content-Type": "application/json" },
      "req_template_json_object": {
        "model": "nemotron-gen",
        "temperature": 0.0,
        "max_tokens": 256,
        "messages": [ { "role": "user", "content": "$INPUT" } ]
      },
      "response_json": true,
      "response_json_field": "$.choices[0].message.content"
    }
  }
}
