# =============================================================================
# .env サンプル（NeMoパイプライン用）
#   使い方: この内容を DevContainer プロジェクトルート（docker-compose.yml と同階層、
#           ホスト側 /Users/.../nvidia_slm/nvidia_slm/.env）へコピーして値を埋め、
#           コンテナを再起動する。
#   注意:
#   - .env は絶対にコミットしない（.gitignore 済み。このサンプルには実キーを書かない）
#   - 本環境は .env の平文管理を警告する（暗号化: scripts/setup-env-encryption.sh / SOPS+age）
#   - 強いキー生成: openssl rand -hex 32
#   - 追加した変数がコンテナ内に渡らない場合は docker-compose.yml の
#     environment / env_file 設定への追記が必要
# =============================================================================

# --- S2 蒸留・S1 caption（教師=Claude。課金が発生するため承認ゲートの対象） ---
# 取得: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Hugging Face（S1 fetch でのデータセット取得 / Nemotron gatedモデルDL） ---
# 取得: https://huggingface.co/settings/tokens （Read権限でよい）
# Nemotron-Nano-9B-v2-Japanese は gated: モデルページで規約同意が別途必要
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# --- NGC（S3/S4/S5 の NeMoコンテナ pull。GPUホスト側で docker login nvcr.io に使用） ---
# 取得: https://ngc.nvidia.com/setup → Generate API Key
# ログイン: docker login nvcr.io  （Username は文字どおり $oauthtoken、Password にこのキー）
NGC_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# --- S6 評価（OpenAI互換エンドポイント。ローカルvLLM/llama.cppなら実キー不要） ---
# 例: GPUホストの vLLM → http://<gpu-host>:8002/v1（make eval 実行時に指定でも可）
OPENAI_BASE_URL=http://localhost:8002/v1
OPENAI_API_KEY=sk-local

# --- 実験トラッキング（任意。Makefileが自動注入するため通常は設定不要） ---
# この環境(DooD)では MLFLOW_PORT=15252 を hostpath.mk で設定済み
# MLFLOW_TRACKING_URI=http://host.docker.internal:15252

# --- Langfuse（任意。S6評価スコア/S7レール発火のトレース用・セルフホスト） ---
# 取得: セルフホストUI(http://localhost:3000) → プロジェクト設定 → API Keys
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# --- GitHub（通常は gh auth login 済みなら不要。CI/自動化で使う場合のみ） ---
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# （参考）この DevContainer 環境自体の制御フラグ — 既存 .env に既にある場合は触らない
# =============================================================================
# ENABLE_FIREWALL=true                  # 外部通信制限（切り分け時のみ false）
# ENABLE_JAVA=false                     # JDK/Maven/Gradle の導入
# ENABLE_SUPPLY_CHAIN_GUARD=true        # パッケージインストール防御
# ENABLE_DOCKERFILE_COOLDOWN_BLOCK=false
# STRICT_EGRESS_BLOCK=false             # python/node経由ネットワークの警告→ブロック化
# TRACE_TO_LANGFUSE=false               # 会話トランスクリプトのLangfuse送信
