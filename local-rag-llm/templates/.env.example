# =============================================================================
# ⚠ セキュリティ: このファイルは雛形。実体 .env は .gitignore 済み（コミット禁止）。
# 強いキーの生成例: openssl rand -hex 32
# 本番は SOPS+age で暗号化し、平文 .env をディスクに残さない運用を推奨。

# .env.example — 実体 .env は git 管理しない（SOPS復号で生成する運用を推奨）
# =============================================================================

# --- LLM / 外部API -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                 # Embedding(text-embedding-3-small)用
HF_TOKEN=hf_...                       # Nemotron(gated)取得に必須。HFで規約同意
# HF_HOME=~/.cache/huggingface        # モデルキャッシュ場所（任意）

# --- AIゲートウェイ(LiteLLM) -------------------------------------------------
LITELLM_MASTER_KEY=   # 必須: openssl rand -hex 32 で生成した値を入れる

# --- ローカル推論サーバの場所 --------------------------------------------------
# 既定(未設定時) = 同一composeのサービス名直結: http://llm-analysis:8000/v1 等
# 別GPU機に委譲する場合のみ上書き（例）:
# QWEN_ANALYSIS_BASE=http://192.168.1.50:8001/v1
# NEMOTRON_GEN_BASE=http://192.168.1.50:8002/v1

# --- PostgreSQL + pgvector ---------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=   # 必須: 強固なパスワード（未設定だとcompose起動が失敗する設計）
POSTGRES_DB=market_report
# 接続URLは2種類あることに注意:
#   コンテナ間(app/DevContainer→db): db:5432 …composeが自動注入するので通常は設定不要
#   ホストから直接(psql等)         : localhost:5433
DATABASE_URL_HOST=postgresql+psycopg://app:change_me_in_prod@localhost:5433/market_report

# --- Langfuse（セルフホスト・別compose） --------------------------------------
# コンテナ間はサービス名(langfuse-web:3000)。composeが注入するため通常は設定不要。
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...

# --- メール取り込み / その他 ---------------------------------------------------
MAILBOX_PATH=./data
STREAMLIT_PASSWORD=   # 必須: 強固なパスワード。未設定なら公開しないこと

# 注:
# - 本番は localhost バインド + 強固なパスワード + TLS。
# - 学習用クレデンシャル(Colab/EC2, S3)はこのファイルに置かない（学習はローカルで行わない）。
